{
  "manifest_version": 3,
  "name": "WinStash: Work Log, Brag Doc & Self-Review",
  "version": "1.2.2",
  "description": "Log your week in a minute. Turn rough notes into a weekly update, brag doc and STAR stories for your self-review. Nothing made up.",
  "action": {
    "default_popup": "index.html",
    "default_title": "WinStash - Quick Log"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "Open WinStash quick log"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://winstash.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://winstash.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
