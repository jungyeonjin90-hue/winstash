# ========================================================
# 1. Firebase Client Configuration (Frontend)
# Firebase 콘솔 (https://console.firebase.google.com/) -> 프로젝트 설정 -> 일반 -> 내 앱 -> 웹 앱 추가 후 아래 값을 채워넣으세요.
# ========================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# (선택) Firebase에 연결된 Google Analytics 측정 ID (G-XXXXXXXXXX)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ========================================================
# 2. Firebase Admin SDK Configuration (Server-Side Backend)
# Firebase 콘솔 -> 프로젝트 설정 -> 서비스 계정 (Service Accounts) -> "새 비공개 키 생성" 클릭하여 다운로드된 JSON 파일의 내용 참조
# ========================================================
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# 비공개 키 (줄바꿈 \n 포함하여 큰따옴표로 감싸서 입력)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ========================================================
# 3. AI Service Configuration (Google Gemini API)
# Google AI Studio (https://aistudio.google.com/)에서 API 키 발급
# ========================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================================
# 4. Lemon Squeezy 결제 및 정기 구독 (WinStash Pro $5.99/mo)
# ========================================================
# 4-1. 레몬스퀴즈 상품 Checkout Link (Store -> Products -> Share -> Copy checkout link)
NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=https://winstash.lemonsqueezy.com/buy/your-variant-id

# 4-2. 레몬스퀴즈 웹훅 서명 검증 시크릿 (Settings -> Webhooks -> Signing Secret)
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ========================================================
# 5. Product Analytics & Session Replay (PostHog)
# ========================================================
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# 4-3. 결제 게이트웨이 라이브 여부 (스토어 승인 후 "true")
NEXT_PUBLIC_LEMON_SQUEEZY_IS_LIVE=false

# ========================================================
# 6. 보안 / 운영 설정
# ========================================================
# 관리자 이메일 허용 목록 (쉼표 구분). 비우면 lib/adminConfig.ts 의 기본값 사용.
# 관리자 권한은 이메일 소유 확인(email_verified)이 끝난 계정에만 적용됩니다.
NEXT_PUBLIC_ADMIN_EMAILS=

# 확장 프로그램 API에 CORS를 허용할 origin (쉼표 구분), 예: chrome-extension://<웹스토어 확장 프로그램 ID>
# (팝업은 host_permissions 로 호출하므로 없어도 동작하지만, 다른 확장 프로그램 컨텍스트에서 호출할 때 필요)
EXTENSION_ALLOWED_ORIGINS=

# Cloudflare 가 모든 요청 앞단에 있을 때만 "true". 그 외에는 클라이언트가 위조할 수 있는 헤더입니다.
TRUST_CF_CONNECTING_IP=false

# (테스트 전용) Gemini 엔드포인트 재정의. E2E 가 로컬 mock 서버를 가리킬 때만 사용하고 운영에는 설정하지 마세요.
# GEMINI_API_BASE_URL=
