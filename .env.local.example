# ========================================================
# 1. Firebase Client Configuration (Frontend)
# Firebase 콘솔 (https://console.firebase.google.com/) -> 프로젝트 설정 -> 일반 -> 내 앱 -> 웹 앱 추가 후 아래 값을 채워넣으세요.
# ========================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# (선택) Firebase에 연결된 Google Analytics 측정 ID (G-XXXXXXXXXX)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ========================================================
# 2. Firebase Admin SDK Configuration (Server-Side Backend)
# Firebase 콘솔 -> 프로젝트 설정 -> 서비스 계정 (Service Accounts) -> "새 비공개 키 생성" 클릭하여 다운로드된 JSON 파일의 내용 참조
# ========================================================
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# 비공개 키 (줄바꿈 \n 포함하여 큰따옴표로 감싸서 입력)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ========================================================
# 3. AI Service Configuration (Google Gemini API)
# Google AI Studio (https://aistudio.google.com/)에서 API 키 발급
# ========================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================================
# 4. Lemon Squeezy 결제 및 정기 구독 (WinStash Pro $5.99/mo)
# ========================================================
# 4-1. 레몬스퀴즈 상품 Checkout Link (Store -> Products -> Share -> Copy checkout link)
NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=https://winstash.lemonsqueezy.com/buy/your-variant-id

# 4-2. 레몬스퀴즈 웹훅 서명 검증 시크릿 (Settings -> Webhooks -> Signing Secret)
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here
