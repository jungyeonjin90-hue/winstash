rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // WinStash 사용자별 철통 격리 보안 규칙
    match /users/{userId} {
      // 본인만 사용자 프로필 읽기 가능
      allow read: if request.auth != null && request.auth.uid == userId;

      // 신규 계정 생성 시: plan 관련 필드는 클라이언트에서 임의 지정 불가 (기본 free 허용)
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
                    && (!('planStatus' in request.resource.data) || request.resource.data.planStatus == 'inactive');

      // 기존 계정 수정 시: 일반 유저는 plan, planStatus, lemonSqueezy* 필드를 직접 수정할 수 없음
      allow update: if request.auth != null && request.auth.uid == userId 
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['plan', 'planStatus', 'lemonSqueezyCustomerId', 'lemonSqueezySubscriptionId']);

      // 본인 계정 삭제 허용
      allow delete: if request.auth != null && request.auth.uid == userId;

      // 사용자 하위 컬렉션 중 usage는 서버(Firebase Admin SDK)에서만 원자적으로 관리 (M-1 위변조 원천 방지)
      // 클라이언트는 실시간 조회만 가능하고 임의 쓰기는 차단
      match /usage/{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // 사용자 하위 컬렉션 (records, persona, summary_cache 등)은 본인에게 읽기/쓰기 허용
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 서비스 전체 사용량 통계 (10,000회 상한선 통제용)
    // 읽기는 누구나 가능, system/usage 문서만 인증된 유저가 카운터 증가 가능
    match /system/usage {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /system/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 사용자 피드백 및 버그 제보 컬렉션
    // 스팸 봇 방지를 위해 로그인한 사용자만 작성 허용, 열람/관리는 관리자만 가능
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.token.email in ["jungyeonjin90@gmail.com", "thestudioplus26@gmail.com"];
    }
  }
}
