rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // WinStash 개인별 철통 격리 보안 규칙 (Security Rules)
    // 오직 Google 인증을 마친 본인(request.auth.uid == userId)만 자신의 데이터(하위 컬렉션 포함)에 접근 가능
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 서비스 전체 사용량 통계 (10,000회 상한선 통제용)
    // 읽기는 누구나 가능, 카운터 업데이트는 인증된 사용자만 가능
    match /system/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 사용자 피드백 및 버그 제보 컬렉션
    // 누구나(비로그인 포함) 작성이 가능하며, 열람 및 관리는 관리자만 가능
    match /feedbacks/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.token.email in ["jungyeonjin90@gmail.com", "thestudioplus26@gmail.com"];
    }
  }
}
