rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 관리자: 허용 목록의 이메일 + 이메일 소유 검증 완료 (감사 H-4: 미검증 이메일 사칭 방지)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ["jungyeonjin90@gmail.com", "thestudioplus26@gmail.com"];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 결제/쿼터 관련 필드: 서버(Admin SDK, Lemon Squeezy 웹훅)만 기록 가능
    function protectedProfileKeys() {
      return ['plan', 'planStatus', 'endsAt', 'renewsAt',
              'lemonSqueezyCustomerId', 'lemonSqueezySubscriptionId',
              'lemonSqueezyEventAt', 'lemonSqueezyLastEvent', 'freeUsedCount'];
    }

    // WinStash 사용자별 철통 격리 보안 규칙
    // 주의: 하위 컬렉션에 `match /{document=**}`를 쓰지 말 것. rules_version 2에서 재귀 와일드카드는
    // 0개 세그먼트에도 매칭되어 users/{userId} 문서 자체(plan 등)와 usage까지 쓰기를 열어버린다 (감사 C-1).
    match /users/{userId} {
      // 본인만 사용자 프로필 읽기 가능
      allow read: if isOwner(userId);

      // 신규 계정 생성 시: 보호 필드는 지정 불가 (plan='free', planStatus='inactive' 기본값만 허용)
      allow create: if isOwner(userId)
                    && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
                    && (!('planStatus' in request.resource.data) || request.resource.data.planStatus == 'inactive')
                    && !request.resource.data.keys().hasAny(
                        ['endsAt', 'renewsAt', 'lemonSqueezyCustomerId', 'lemonSqueezySubscriptionId',
                         'lemonSqueezyEventAt', 'lemonSqueezyLastEvent', 'freeUsedCount']);

      // 기존 계정 수정 시: 보호 필드는 변경 불가
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedProfileKeys());

      // 본인 계정 삭제 허용
      allow delete: if isOwner(userId);

      // usage는 서버(Firebase Admin SDK)에서만 원자적으로 관리. 클라이언트는 조회만 가능
      match /usage/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // 본인 데이터 하위 컬렉션 (여기 없는 컬렉션은 기본 거부)
      match /records/{recordId} {
        allow read, write: if isOwner(userId);
      }
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }
      match /summary_cache/{cacheKey} {
        allow read, write: if isOwner(userId);
      }
    }

    // 서비스 전체 사용량 통계 (10,000회 상한선 통제용) 포함 system 문서
    // 읽기는 누구나 가능, 쓰기는 서버(Admin SDK)만 가능 (감사 H-5: 임의 유저가 킬스위치를 조작할 수 있었음)
    match /system/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 사용자 피드백 및 버그 제보 컬렉션
    // 스팸 봇 방지를 위해 로그인한 사용자만 작성 허용(본인 uid, 정해진 필드·길이만), 열람/관리는 관리자만 가능
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null && isValidFeedback(feedbackId);
      allow read, update, delete: if isAdmin();
    }

    // lib/firestoreService.ts submitFeedbackToFirestore() 의 FeedbackReport 형태 + FEEDBACK_LIMITS 와 일치 (감사 M-10)
    function isValidFeedback(feedbackId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'type', 'title', 'message', 'userId', 'status', 'createdAt'])
        && d.keys().hasOnly(['id', 'type', 'title', 'message', 'userEmail', 'userId', 'status', 'metadata', 'createdAt'])
        && d.id == feedbackId
        && d.type in ['bug', 'feature', 'general']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.message is string && d.message.size() > 0 && d.message.size() <= 5000
        && optionalString(d, 'userEmail', 254)
        && d.userId == request.auth.uid
        && d.status == 'new'
        && d.createdAt is string && d.createdAt.size() <= 40
        && (!('metadata' in d) || isValidFeedbackMetadata(d.metadata));
    }

    function isValidFeedbackMetadata(m) {
      return m is map
        && m.keys().hasOnly(['userAgent', 'screenResolution', 'pathname', 'platform', 'language'])
        && optionalString(m, 'userAgent', 500)
        && optionalString(m, 'screenResolution', 500)
        && optionalString(m, 'pathname', 500)
        && optionalString(m, 'platform', 500)
        && optionalString(m, 'language', 500);
    }

    function optionalString(m, key, maxSize) {
      return !(key in m) || (m[key] is string && m[key].size() <= maxSize);
    }

    // Pro 멤버십 얼리액세스 대기자 명단 (pro_waitlist)
    // 로그인 및 비로그인 방문자 모두 신청 가능. 문서 ID = 소문자 이메일.
    // 최초 신청(create)만 허용하고 기존 항목 덮어쓰기(update)는 금지 (감사 M-8: 타인 항목 탈취/변조 방지)
    // 개인정보 보호: 타인의 신청 내역 조회 및 삭제 불가, 관리자만 열람/삭제 가능
    match /pro_waitlist/{emailDoc} {
      allow create: if isValidWaitlistEntry(emailDoc);
      allow read, delete: if isAdmin();
    }

    // PricingWaitlistButton / UpgradeModal 이 보내는 필드 구성과 일치해야 함
    function isValidWaitlistEntry(emailDoc) {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'userId', 'displayName', 'triggerReason', 'joinedAt', 'source'])
        && d.email is string
        && d.email == emailDoc
        && d.email.size() <= 254
        && d.email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$')
        // 로그인 사용자는 본인 uid만, 비로그인 방문자는 "anonymous"만 기록 가능
        && (request.auth != null ? d.userId == request.auth.uid : d.userId == 'anonymous')
        && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 100))
        && (!('triggerReason' in d) || (d.triggerReason is string && d.triggerReason.size() <= 50))
        && (!('source' in d) || (d.source is string && d.source.size() <= 50))
        && (!('joinedAt' in d) || d.joinedAt == request.time);
    }
  }
}
